{
  "name": "digitalburj-academy",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-portable.mjs",
    "db:generate": "drizzle-kit generate",
    "test": "node tests/academy.test.mjs && node tests/receipts.test.mjs && node content/server-qa.mjs && node content/auth-qa.mjs && node content/mentor-qa.mjs && node content/qa.cjs && node tests/standard.test.mjs && node tests/access.test.mjs && node tests/production.test.mjs && node tests/portable.test.mjs",
    "start": "node --env-file-if-exists=.env server/start.mjs",
    "preview": "node --env-file-if-exists=.env server/start.mjs",
    "curriculum": "python3 content/build_atlas.py",
    "test:academy": "node tests/academy.test.mjs",
    "test:browser": "node tests/browser.test.mjs",
    "test:payment-ui": "node tests/payment-ui.test.mjs",
    "test:integration-ui": "node tests/integration-ui.test.mjs",
    "test:standard": "node tests/standard.test.mjs",
    "test:standard-ui": "node tests/standard-ui.test.mjs",
    "test:access": "node tests/access.test.mjs && node tests/production.test.mjs",
    "test:production": "node tests/production.test.mjs",
    "test:production-ui": "node tests/production-ui.test.mjs",
    "test:access-ui": "node tests/access-ui.test.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/database.mjs",
    "db:check": "node --env-file-if-exists=.env scripts/database.mjs --check",
    "session:key": "node scripts/session-key.mjs",
    "test:portable": "node tests/portable.test.mjs",
    "check:env": "node --env-file-if-exists=.env scripts/check-config.mjs",
    "test:portable-ui": "node tests/portable-ui.test.mjs",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "cloudflare:dry-run": "npm run build:cloudflare && wrangler deploy --dry-run --outdir .cloudflare/bundled",
    "cloudflare:deploy": "npm run build:cloudflare && wrangler deploy",
    "test:cloudflare": "node tests/cloudflare.test.mjs",
    "test:cloudflare-runtime": "node tests/cloudflare-runtime.test.mjs",
    "cloudflare:secrets": "node --env-file=.env.cloudflare scripts/cloudflare-secrets.mjs"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.4",
    "drizzle-orm": "0.44.5",
    "esbuild": "0.25.5",
    "jsbarcode": "^3.12.1",
    "jsqr": "^1.4.0",
    "linkedom": "0.18.12",
    "pngjs": "^7.0.0",
    "qrcode-generator": "^2.0.4",
    "simple-icons": "16.33.0",
    "wrangler": "4.145.0"
  },
  "version": "5.0.0",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@libsql/client": "0.18.0"
  }
}
