# DigitalBurj Academy standalone hosting — enter real values privately.
NODE_ENV=production
ACADEMY_PUBLIC_URL=
ACADEMY_OWNER_EMAIL=
# Generate using npm run session:key. Keep it stable; it encrypts sessions/merchant keys.
ACADEMY_SESSION_KEY=
# Hosted persistent libSQL/Turso database; no temporary filesystem in production.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Supabase Auth only; email confirmation + SMTP + templates in docs/DEPLOYMENT.md.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# false: run db:migrate before deployment. true: safely migrate during startup.
ACADEMY_AUTO_MIGRATE=false
# Enable after checking real merchant offers and public signed notifications.
ACADEMY_PAYMENT_PUBLIC=false
# Render/Railway normally use 1 trusted ingress proxy. Local development uses 0.
ACADEMY_TRUST_PROXY=0
# Cloud services set PORT. Local default: 3000.
# PORT=3000
# Razorpay credentials are verified on startup; do not set RAZORPAY_VERIFIED manually.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Prefer owner forms for approved offers/business details. No invented prices.
ACADEMY_LIVE_PRODUCTS=[]
ACADEMY_BUSINESS={}
# Optional eligible commercial providers. Configure the matching approved offers.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
GUMROAD_ACCESS_TOKEN=
GUMROAD_SELLER_ID=
GUMROAD_WEBHOOK_SECRET=
BINANCE_PAY_KEY=
BINANCE_PAY_SECRET=
BINANCE_PAY_MERCHANT_ID=
BINANCE_PAY_PUBLIC_KEY=
BINANCE_PAY_CERTIFICATE_SN=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
ACADEMY_CRYPTO_ASSETS=[]
